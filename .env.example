# ============================================
# Peluang.ai — Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================

# --- Database ---
# PostgreSQL connection string (asyncpg driver)
# For Docker Compose default: use the value below as-is
DATABASE_URL=postgresql+asyncpg://peluang:peluang_dev@localhost:5432/peluang

# Redis connection string (used by arq task queue)
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production

# --- AI Providers ---
# Provider: "openrouter" (cloud, needs API key) or "ollama" (local, free)
AI_PROVIDER=openrouter

# OpenRouter: get your key at https://openrouter.ai/keys
# Free models available (e.g. meta-llama/llama-3.1-8b-instruct:free)
OPENROUTER_API_KEY=

# Model selection (OpenRouter model IDs)
AI_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_VISION_MODEL=google/gemini-flash-1.5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Ollama (local fallback): install from https://ollama.com
# Then run: ollama pull llama3.1:8b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# --- Telegram Bot ---
# 1. Message @BotFather on Telegram
# 2. Send /newbot, follow prompts to name your bot
# 3. Copy the token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# 4. Paste it below
TELEGRAM_BOT_TOKEN=

# --- App ---
# Base URL of the Next.js frontend (used for deep links in Telegram)
WEB_BASE_URL=http://localhost:3000

# Storage backend: "local" (filesystem) — S3/Supabase Storage can be added later
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
